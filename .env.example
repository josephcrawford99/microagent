# Copy to .env (repo root, or inside the microagent home) and fill in what you use.
# Everything here is optional — an empty .env runs fine with provider = "ping".

# providers/ — only the one named by [agents.<id>] provider is needed
CLAUDE_CODE_OAUTH_TOKEN=
GEMINI_API_KEY=

# services/ — only for the services enabled in config.toml
TELEGRAM_BOT_TOKEN=
EMAIL_PASSWORD=
BADGE_TOKEN=

# dashboard — the token that grants access via cloudflare (LAN needs none)
DASHBOARD_TOKEN=

# override the mutable home dir (default <repo>/.microagent)
# MICROAGENT_HOME=
